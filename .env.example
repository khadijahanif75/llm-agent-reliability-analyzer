# LLM Configuration
LLM_PROVIDER=mock

# Add your API key locally when using a real provider
LLM_API_KEY=

# Agent Configuration
MAX_STEPS=10
RETRY_ENABLED=true
MAX_RETRIES=2

# Database
DATABASE_URL=sqlite:///./data/agent_reliability.db

# Failure Injection
SEARCH_FAILURE_RATE=0.0
DATABASE_FAILURE_RATE=0.0
SEARCH_TIMEOUT_RATE=0.0

# Experiment Configuration
RANDOM_SEED=42